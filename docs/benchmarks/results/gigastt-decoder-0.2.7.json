s.rs\n+++ b/crates/gigastt-core/src/inference/audio/opus.rs\n@@ -69,4 +69,12 @@ fn check_opus_channels(channels: usize) -> Result<()> {\n #[cfg(feature = \"file-decode\")]\n-fn new_opus_decoder(channels: usize) -> Result<opus_rs::OpusDecoder> {\n-    opus_rs::OpusDecoder::new(OPUS_DECODE_RATE as i32, channels)\n+fn new_opus_decoder(channels: usize) -> Result<opura::decoder::OpusDecoder> {\n+    {\n+        use opura::silk::{decoder::PcmChannels, resampler::OutputRate};\n+        let layout = match channels {\n+            1 => PcmChannels::Mono,\n+            2 => PcmChannels::Stereo,\n+            _ => anyhow::bail!(\"unsupported channel count\"),\n+        };\n+        opura::decoder::OpusDecoder::new(OutputRate::Khz48, layout)\n+    }\n         .map_err(|e| anyhow::anyhow!(\"Opus decoder init failed: {e}\"))\n@@ -87,3 +95,3 @@ fn new_opus_decoder(channels: usize) -> Result<opus_rs::OpusDecoder> {\n fn decode_packet_interleaved(\n-    decoder: &mut opus_rs::OpusDecoder,\n+    decoder: &mut opura::decoder::OpusDecoder,\n     channels: usize,\n@@ -104,6 +112,12 @@ fn decode_packet_interleaved(\n         scratch.extend_from_slice(frame);\n-        let written = decoder\n-            .decode(scratch, frame_size, &mut pcm[decoded * channels..])\n-            .map_err(|e| anyhow::anyhow!(\"Opus decode error: {e}\"))?\n-            .min(frame_size);\n+        let output = decoder.decode(scratch)?;\n+        let written = output.samples_per_channel();\n+        anyhow::ensure!(written == frame_size, \"unexpected decoded frame length\");\n+        let start = decoded * channels;\n+        for (destination, &value) in pcm[start..start + written * channels]\n+            .iter_mut()\n+            .zip(output.samples())\n+        {\n+            *destination = f32::from(value) / 32768.0;\n+        }\n         decoded += written;\n@@ -126,3 +140,3 @@ fn decode_packet_interleaved(\n pub(super) struct OpusStream {\n-    decoder: opus_rs::OpusDecoder,\n+    decoder: opura::decoder::OpusDecoder,\n     channels: usize,\n"
  },

    "standalone_main": "fn resident_stack_kib(address: usize) -> Result<usize> {\n    let mut in_stack = false;\n    for line in fs::read_to_string(\"/proc/self/smaps\")?.lines() {\n        let mut fields = line.split_ascii_whitespace();\n        if let Some((lo, hi)) = fields.next().and_then(|word| word.split_once('-')) {\n            let range = usize::from_str_radix(lo, 16)?..usize::from_str_radix(hi, 16)?;\n            in_stack = range.contains(&address);\n        } else if in_stack && line.starts_with(\"Rss:\") {\n            return Ok(line.split_ascii_whitespace().nth(1).ok_or(\"RSS\")?.parse()?);\n        }\n    }\n    Err(\"worker stack mapping not found\".into())\n}\nfn main() -> Result<()> {\n    use std::sync::mpsc::sync_channel;\n    let args: Vec<_> = env::args().collect();\n    let clips = corpus(Path::new(&args[1]))?;\n    let hz = args[2].parse()?;\n    let (tx, rx) = sync_channel(0);\n    let (ack, go) = sync_channel(0);\n    let worker = std::thread::Builder::new().stack_size(4 * 1024 * 1024).spawn(move || {\n        let anchor = 1u8;\n        tx.send(black_box(&anchor) as *const u8 as usize).unwrap();\n        go.recv().unwrap();\n        pass(&clips, hz, None).unwrap();\n        tx.send(black_box(&anchor) as *const u8 as usize).unwrap();\n        go.recv().unwrap();\n    })?;\n    let address = rx.recv()?;\n    let before = resident_stack_kib(address)?;\n    ack.send(())?;\n    assert_eq!(rx.recv()?, address);\n    let after = resident_stack_kib(address)?;\n    ack.send(())?;\n    worker.join().map_err(|_| \"worker panicked\")?;\n    println!(\"{before},{after}\");\n    Ok(())\n}\n",

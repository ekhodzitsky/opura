+fn synthesize_lpc<const ORDER: usize>(short: &mut [i32; 96], residual: &[i32], filter: &[i16]) {
+    // Match increasing history addresses to the oldest coefficient first.
+    // SILK shifts each product to Q10 before adding it to the prediction.
+    let coefficients: [i16; ORDER] = std::array::from_fn(|j| filter[ORDER - 1 - j]);
+    for (i, &sample) in residual.iter().enumerate() {
+        let end = 16 + i;
+        let mut prediction = (ORDER / 2) as i32;
+        for (&previous, &coefficient) in short[end - ORDER..end].iter().zip(&coefficients) {
+            prediction = prediction.wrapping_add(mul_wb(previous, i32::from(coefficient)));
+        }
+        short[end] = sample.saturating_add(shift_saturated(prediction, 4));
     }
